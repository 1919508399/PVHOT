PVHOT_WECHAT_GATEWAY_HOST=127.0.0.1
PVHOT_WECHAT_GATEWAY_PORT=4399
PVHOT_WECHAT_GATEWAY_REFRESH_HOURS=6
# Production should inject these two values through the service environment.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PVHOT_WECHAT_GATEWAY_ADMIN_TOKEN=
PVHOT_WECHAT_GATEWAY_KEY=
# Experimental bridge adapter. Keep replaceable because the upstream is archived.
PVHOT_WECHAT_PLATFORM_URL=https://weread.111965.xyz
# Only enable consumption after the isolated prototype has passed observation.
PVHOT_ENABLE_WECHAT_GATEWAY=0
