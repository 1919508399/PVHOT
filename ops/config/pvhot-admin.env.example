# Copy to /etc/pvhot/pvhot-admin.env with mode 0600.
# Do not commit the real hash. Generate it locally and insert only on the server:
# node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" 'your-new-password'

PVHOT_ADMIN_PASSWORD_HASH=REPLACE_WITH_A_64_CHARACTER_SHA256_HEX_DIGEST
