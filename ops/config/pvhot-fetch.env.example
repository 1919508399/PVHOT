# Copy to /etc/pvhot/pvhot-fetch.env with owner root:root and mode 0600.
# Install Chromium once on the server and point Puppeteer at that managed binary.
# X monitoring is optional. Keep the value below empty in Git; if enabled, add the
# real token only to the root-only server copy. Never paste it into a unit file,
# deployment log, issue, pull request, or command that will be saved in shell history.

PUPPETEER_EXECUTABLE_PATH=/opt/pvhot/chrome/chrome
PVHOT_ENABLE_FREEWECHAT=0
PVHOT_X_BEARER_TOKEN=
