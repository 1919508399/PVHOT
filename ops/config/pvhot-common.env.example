# Copy to /etc/pvhot/pvhot-common.env.
# Keep this file non-secret; both the API and scheduled jobs read it.

PVHOT_MAX_AGE_DAYS=7
PVHOT_MAX_ITEMS=280
PVHOT_ENRICH_LIMIT=84
PVHOT_GOOGLE_DECODE_LIMIT=48
PVHOT_WECHAT_ACCOUNT_BATCH=8
PVHOT_WECHAT_TOPIC_BATCH=4
PVHOT_WECHAT_LINK_RESOLVE_LIMIT=4
PVHOT_WECHAT_LINK_RESOLVE_TIMEOUT_MS=15000
PVHOT_WECHAT_LINK_RESOLVE_WAIT_MS=750
PVHOT_WECHAT_GATEWAY_HEALTH_MAX_AGE_MS=28800000
